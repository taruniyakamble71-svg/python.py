arr = [10, 20, 30, 40, 50]
key = 30

for i in range(len(arr)):
    if arr[i] == key:
        print("Linear Search:", i)
        break

low, high = 0, len(arr) - 1

while low <= high:
    mid = (low + high) // 2

    if arr[mid] == key:
        print("Binary Search:", mid)
        break
    elif arr[mid] < key:
        low = mid + 1
    else:
        high = mid - 1